# Every credential and private value for this repo, loaded by Varlock
# (https://varlock.dev/env-spec) with its 1Password plugin. This repo is
# public: values here are only op:// references, never the values.
#
# Loaded by the tofu wrapper (terranix/load-secrets.nix) before each run.
# Check what resolves, redacted: `env-check` in the devenv shell.
#
# Login to 1Password, either:
#   - the 1Password desktop app (biometric unlock): set OP_ACCOUNT in .env
#   - a service account (CI, no desktop app): set OP_SERVICE_ACCOUNT_TOKEN in .env
#
# @defaultRequired=true @defaultSensitive=true
# @plugin(@varlock/1password-plugin@2.0.6)
# @initOp(token=$OP_SERVICE_ACCOUNT_TOKEN, allowAppAuth=true)
# ---

# --- 1Password login --- #

# Service account token with read+write access to the azure-infra vault.
# Leave empty to use the desktop app. Not @internal: the OpenTofu
# 1Password provider needs it too.
# @type=opServiceAccountToken @optional @internal=false
OP_SERVICE_ACCOUNT_TOKEN=

# Your 1Password account for desktop app login (`op account list`, the
# sign-in address shorthand). Read from the environment by the op CLI and
# the OpenTofu 1Password provider (initOp's account= only takes a literal).
# @optional @sensitive=false
OP_ACCOUNT=

# Vault that holds everything below and the passwords tofu generates.
# @sensitive=false
TF_VAR_onepassword_vault=azure-infra

# --- Azure service principal (docs: getting-started) --- #

ARM_SUBSCRIPTION_ID=op(op://azure-infra/azure-service-principal/subscription_id)
ARM_TENANT_ID=op(op://azure-infra/azure-service-principal/tenant_id)
ARM_CLIENT_ID=op(op://azure-infra/azure-service-principal/client_id)
ARM_CLIENT_SECRET=op(op://azure-infra/azure-service-principal/client_secret)

# --- OpenTofu state (private Azure Storage account) --- #

# Storage account name, made by scripts/azure-bootstrap.sh and passed to
# `tofu init` by the wrapper. The backend logs in with the ARM_* values.
TF_STATE_STORAGE_ACCOUNT=op(op://azure-infra/sql-server-settings/state_storage_account)

# Encrypts state and plans. Losing or changing it makes the state
# unreadable: never edit this item.
TF_VAR_state_passphrase=op(op://azure-infra/tofu-state-passphrase/password)

# --- Firewall allow-lists (private: this repo is public) --- #

# Comma-separated CIDRs, e.g. 198.51.100.7/32, 203.0.113.0/24.
# Empty field: no access from the internet.
# @optional
TF_VAR_rdp_source_cidrs=op(op://azure-infra/sql-server-settings/rdp_source_cidrs)
# @optional
TF_VAR_sql_source_cidrs=op(op://azure-infra/sql-server-settings/sql_source_cidrs)
